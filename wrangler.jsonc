{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apocryphal-me",
  "compatibility_date": "2026-01-14",
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],
  "assets": {
    "directory": "dist"
  },
  // Uncomment routes when domain DNS is pointed at Cloudflare:
  // "routes": [
  //   { "pattern": "apocryphal.me/*", "zone_name": "apocryphal.me" },
  //   { "pattern": "www.apocryphal.me/*", "zone_name": "apocryphal.me" }
  // ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  }
}

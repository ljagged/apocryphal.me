---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const { title, description = 'Dispatches from outside the canon.', wide = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title === 'apocryphal.me' ? title : `${title} — apocryphal.me`}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="apocryphal.me" href="/feed.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,300..900;1,8..60,300..900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <!-- Theme -->
    <script is:inline>
      const theme = (() => {
        const stored = localStorage.getItem('theme');
        if (stored) return stored;
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      })();
      document.documentElement.setAttribute('data-theme', theme);
    </script>
  </head>
  <body>
    <div class={`site-container${wide ? ' site-container--wide' : ''}`}>
      <header class="site-header">
        <a href="/" class="site-title">apocryphal.me</a>
        <nav class="site-nav">
          <a href="/posts/">Posts</a>
          <a href="/notes/">Notes</a>
          <a href="/about/">About</a>
          <button class="theme-toggle" aria-label="Toggle dark mode" type="button">
            <span class="theme-icon-light">&#9790;</span>
            <span class="theme-icon-dark">&#9788;</span>
          </button>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <p>
          <a href="/feed.xml">RSS</a> ·
          No tracking, no cookies, no surveillance.
        </p>
      </footer>
    </div>

    <script is:inline>
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });
    </script>

    <style>
      .site-container {
        max-width: var(--content-width);
        margin: 0 auto;
        padding: 48px var(--page-padding) 64px;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      /* Wide variant for post pages with sidenotes.
         The container expands to fit content + sidenote gutter.
         Text stays at content-width; sidenotes occupy the right margin. */
      @media (min-width: 960px) {
        .site-container--wide {
          max-width: calc(var(--content-width) + var(--sidenote-width) + var(--sidenote-gap) + var(--page-padding) * 2);
        }
      }

      main {
        flex: 1;
      }

      .site-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 48px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--border-light);
      }

      .site-title {
        font-size: 1.4em;
        font-style: italic;
        border-bottom: none;
      }

      .site-title:hover {
        border-bottom: none;
      }

      .site-nav {
        display: flex;
        gap: 20px;
        align-items: center;
        font-size: var(--font-size-sm);
      }

      .site-nav a {
        border-bottom: none;
        color: var(--text-muted);
      }

      .site-nav a:hover {
        color: var(--text);
        border-bottom: none;
      }

      .theme-toggle {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 1.1em;
        padding: 0;
        line-height: 1;
        color: var(--text-muted);
      }

      .theme-toggle:hover {
        color: var(--text);
      }

      [data-theme="dark"] .theme-icon-light { display: none; }
      [data-theme="light"] .theme-icon-dark { display: none; }
      [data-theme="dark"] .theme-icon-dark { display: inline; }
      [data-theme="light"] .theme-icon-light { display: inline; }
      /* Default before JS runs */
      .theme-icon-dark { display: none; }

      .site-footer {
        margin-top: 64px;
        padding-top: 20px;
        border-top: 1px solid var(--border-light);
        font-family: var(--font-mono);
        font-size: var(--font-size-xs);
        color: var(--text-faint);
      }

      .site-footer a {
        color: var(--text-faint);
        border-bottom-color: var(--border-light);
      }

      @media (max-width: 600px) {
        .site-header {
          flex-direction: column;
          gap: 12px;
        }

        .site-container {
          padding-top: 32px;
        }
      }
    </style>
  </body>
</html>
